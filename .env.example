APP_NAME="Campus Lost & Found"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase (PostgreSQL). Gunakan nilai dari dashboard Supabase.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# Wajib true saat memakai transaction pooler Supabase (port 6543).
DB_EMULATE_PREPARES=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true pada deployment HTTPS (produksi).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Penyimpanan media: "local" (dev) atau "s3" (Supabase Storage, wajib di Vercel).
MEDIA_DISK_DRIVER=local
# Isi bagian ini hanya bila MEDIA_DISK_DRIVER=s3.
# Ambil Access Key, region, dan endpoint dari Dashboard > Storage > S3.
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=ap-south-1
# Endpoint standar. Untuk unggahan besar bisa pakai https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_PUBLIC_BUCKET=lost-found-public
SUPABASE_PRIVATE_BUCKET=lost-found-private
SUPABASE_STORAGE_PATH_STYLE=true
# Opsional; otomatis diturunkan dari endpoint + bucket publik bila dikosongkan.
SUPABASE_PUBLIC_URL=

CACHE_STORE=database

# "log" only writes messages to the application log; use SMTP to deliver campus invitations.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

DEFAULT_CAMPUS_NAME="Kampus Utama"
DEFAULT_CAMPUS_SLUG=kampus-utama

# Email akun yang boleh mengelola daftar kampus. Harus ber-role admin.
PLATFORM_ADMIN_EMAIL=

# Daftar proxy tepercaya, pisahkan dengan koma (mis. "10.0.0.1,10.0.0.2").
# Kosongkan bila aplikasi tidak berada di belakang reverse proxy.
TRUSTED_PROXIES=
